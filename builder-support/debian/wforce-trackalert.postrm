#!/bin/sh

set -e

TRACKALERTCONF=/etc/wforce/trackalert.conf

case "$1" in
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
    ;;

    remove)
    ;;

    purge)
        for ext in .new .ucf-new .ucf-old .ucf-dist ""; do
            rm -f "${TRACKALERTCONF}${ext}"
        done
        if command -v ucf >/dev/null 2>&1; then
            ucf --purge "${TRACKALERTCONF}"
        fi
        if command -v ucfr >/dev/null 2>&1; then
            ucfr --purge wforce-trackalert "${TRACKALERTCONF}"
        fi
    ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

#DEBHELPER#

exit 0
