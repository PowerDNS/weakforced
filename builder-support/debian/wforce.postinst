#!/bin/sh

set -e

_WFORCECONF=wforce.conf

WFORCECONF_SOURCE="/usr/share/wforce/${_WFORCECONF}"
WFORCECONF="/etc/wforce/${_WFORCECONF}"
WFORCECONF_NEW="${WFORCECONF}.new"

extract_web_password()
{
    sed -n '
        /^[[:space:]]*setWebserverPassword[[:space:]]*(/ {
            s/^[^"]*"//
            /"/!q
            s/".*$//
            p
            q
        }
    ' "$1"
}

extract_set_key()
{
    sed -n '
        /^[[:space:]]*setKey[[:space:]]*(/ {
            s/^[[:space:]]*//
            p
            q
        }
    ' "$1"
}

escape_sed_replacement()
{
    printf '%s' "$1" | sed 's/[\\&|]/\\&/g'
}

replace_credentials()
{
    config=$1
    webpwd_replacement=--WEBPWD
    setkey_replacement=--SETKEY

    if [ -n "${WEBPWD}" ]; then
        webpwd_replacement=$(escape_sed_replacement "${WEBPWD}")
    fi
    if [ -n "${SETKEY}" ]; then
        setkey_replacement=$(escape_sed_replacement "${SETKEY}")
    fi

    sed -e "s|--WEBPWD|${webpwd_replacement}|g" \
        -e "s|--SETKEY|${setkey_replacement}|g" \
        -i "${config}"
}

generate_missing_credentials()
{
    if [ -z "${SETKEY}" ]; then
        KEY=$(dd if=/dev/urandom bs=32 count=1 2>/dev/null | base64)
        if [ "${#KEY}" -ne 44 ]; then
            echo "Unable to generate a valid key for ${WFORCECONF}" >&2
            return 1
        fi
        SETKEY="setKey(\"${KEY}\")"
    fi
    if [ -z "${WEBPWD}" ]; then
        WEBPWD=$(dd if=/dev/urandom bs=1 count=32 2>/dev/null |
            base64 | rev | cut -b 2-14 | rev)
    fi

    if [ -z "${SETKEY}" ] || [ -z "${WEBPWD}" ]; then
        echo "Unable to generate credentials for ${WFORCECONF}" >&2
        return 1
    fi
}

has_placeholders()
{
    grep -q -e '--WEBPWD' -e '--SETKEY' "$1"
}

ensure_no_placeholders()
{
    if has_placeholders "$1"; then
        echo "Credential placeholders remain in $1" >&2
        return 1
    else
        status=$?
        [ "${status}" -eq 1 ] || return "${status}"
    fi
}

case "$1" in
  configure)
    if [ -e "/etc/wforce.conf" ]; then
        echo "Found old config file /etc/wforce.conf. Moving it to ${WFORCECONF}"
        if [ -e "${WFORCECONF}" ]; then
            mv "${WFORCECONF}" "${WFORCECONF}.backup.$$"
        fi
        cp -a /etc/wforce.conf "/etc/wforce.conf.backup.$$"
        mv /etc/wforce.conf "${WFORCECONF}"
    fi

    rm -f "${WFORCECONF_NEW}"
    trap 'rm -f "${WFORCECONF_NEW}"' 0
    install -m 0600 "${WFORCECONF_SOURCE}" "${WFORCECONF_NEW}"

    for placeholder in --WEBPWD --SETKEY; do
        if ! grep -q -- "${placeholder}" "${WFORCECONF_NEW}"; then
            echo "Missing ${placeholder} in ${WFORCECONF_SOURCE}" >&2
            exit 1
        fi
    done

    SETKEY=
    WEBPWD=
    if [ -e "${WFORCECONF}" ]; then
        SETKEY=$(extract_set_key "${WFORCECONF}")
        WEBPWD=$(extract_web_password "${WFORCECONF}")
        case "${SETKEY}" in
            *--SETKEY*) SETKEY= ;;
        esac
        case "${WEBPWD}" in
            *--WEBPWD*) WEBPWD= ;;
        esac
    else
        printf 'Generating credentials for %s\n' "${WFORCECONF}"
        generate_missing_credentials
    fi

    replace_credentials "${WFORCECONF_NEW}"

    UCF_FORCE_CONFFMISS=1 \
        ucf --three-way --debconf-ok "${WFORCECONF_NEW}" "${WFORCECONF}"
    ucfr wforce "${WFORCECONF}"

    if has_placeholders "${WFORCECONF}"; then
        generate_missing_credentials
        replace_credentials "${WFORCECONF}"
    else
        status=$?
        [ "${status}" -eq 1 ] || exit "${status}"
    fi
    ensure_no_placeholders "${WFORCECONF}"

    chmod 0640 "${WFORCECONF}"
    chown wforce:wforce "${WFORCECONF}"
  ;;

  abort-upgrade|abort-remove|abort-deconfigure)
  ;;

  *)
    echo "postinst called with unknown argument \`$1'" >&2
    exit 1
  ;;
esac

# Init script has errors in previous versions. Postinst script should just
# return the exit status of this script
initscript_error() {
	return $1
}

#DEBHELPER#

exit 0
